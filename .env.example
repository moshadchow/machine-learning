# OMS API configuration — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real credentials or tokens.

OMS_API_BASE_URL=https://test-oms-api.ecosoftbd.com

# Login credentials (used by oms_auth.py to obtain an access token)
OMS_LOGIN_ID=
OMS_PASSWORD=
OMS_DEVICE_ID=Android-01
# MFA is OPTIONAL — only for accounts with MFA enabled. When unset, empty
# values are sent and the API decides. For MFA-enabled accounts, OMS_MFA_CODE
# may be a one-time/rotating code: when login is rejected, update it and
# restart the app.
OMS_MFA_KEY=
OMS_MFA_CODE=

# Data-retrieval settings
OMS_BROKER_IDS=
OMS_FROM_DATE=
OMS_TO_DATE=
OMS_STOCK_EXCHANGE=1
